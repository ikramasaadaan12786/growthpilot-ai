# GrowthPilot AI Environment Configuration Template

# Database Connection (SQLite in Dev, PostgreSQL in Prod)
DATABASE_URL="file:./dev.db"

# Next.js Application URL & Security Secrets
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="growthpilot_development_secret_replace_in_production"
ENCRYPTION_KEY="growthpilot_default_secure_secret_key_32bytes"

# AI Model Provider Credentials
OPENAI_API_KEY=""
GEMINI_API_KEY=""

# Meta (Instagram Professional & Facebook Pages) OAuth 2.0 Credentials
META_CLIENT_ID=""
META_CLIENT_SECRET=""
META_REDIRECT_URI="http://localhost:3000/api/auth/oauth/instagram/callback"

# LinkedIn OAuth 2.0 Credentials
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
LINKEDIN_REDIRECT_URI="http://localhost:3000/api/auth/oauth/linkedin/callback"

# TikTok for Developers Credentials
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
TIKTOK_REDIRECT_URI="http://localhost:3000/api/auth/oauth/tiktok/callback"

# Stripe Billing (Optional)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
